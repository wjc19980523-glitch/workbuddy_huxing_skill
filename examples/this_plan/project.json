  "captions": [
    { "t0": 2.0, "t1": 4.9, "zh": "只给它一张户型图", "hl": "一张户型图", "en": "One floor plan. That's all it gets." },
    { "t0": 5.2, "t1": 8.2, "zh": "墙、门、窗、尺寸，全部自动识别", "en": "Walls, doors, windows, dimensions — read automatically." },
    { "t0": 9.0, "t1": 13.2, "zh": "先出一套 CAD 施工图", "hl": "CAD 施工图", "en": "First, a full set of CAD drawings." },
    { "t0": 14.0, "t1": 16.2, "zh": "只有真正的墙，才从线里长出来", "hl": "真正的墙", "en": "Only the real walls grow out of the lines." },
    { "t0": 16.6, "t1": 20.2, "zh": "家具按真实尺寸，一件件落位", "hl": "真实尺寸", "en": "Furniture at true scale, placed piece by piece." },
    { "t0": 21.0, "t1": 25.2, "zh": "按动线，一间一间走进去", "hl": "一间一间", "en": "Room by room, along the way you'd walk in." },
    { "t0": 31.0, "t1": 35.0, "zh": "每个房间，名字和面积都标好", "hl": "名字和面积", "en": "Every room, named and measured." },
    { "t0": 39.5, "t1": 44.0, "zh": "这就是能住进去的那套房子", "hl": "能住进去", "en": "The home you can actually move into." }
  ],
